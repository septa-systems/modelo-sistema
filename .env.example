# Copie para .env (cp .env.example .env). O .env nunca vai para o GitHub.
# No teste e na produção, estes valores ficam no painel do servidor, com chaves diferentes.

DEBUG=True
# Gere uma nova: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-no-seu-pc
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# No docker compose o banco já vem configurado. Fora dele, ajuste aqui.
DATABASE_URL=postgres://sistema:sistema-local@localhost:5432/sistema

# Endereço do admin (diferente de /admin/)
ADMIN_URL=painel-interno/

# Produção: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend + EMAIL_URL
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
